# JWT signing secret — use a long random value
SECRET_KEY=""

# --- PostgreSQL (Docker Compose) ------------------------------------
# Single source of truth: docker-compose.yml uses these for the container,
# and DATABASE_URL below is derived from them automatically
# (pydantic-settings expands ${VAR} references inside the same .env file).
POSTGRES_USER=blog_user
POSTGRES_PASSWORD=password
POSTGRES_DB=blog_db
POSTGRES_PORT=5432

# App connection URL — built from the POSTGRES_* vars above.
DATABASE_URL="postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}"

MAIL_SERVER=""
MAIL_PORT=""
MAIL_USERNAME=""
MAIL_PASSWORD=""
MAIL_FROM=""
MAIL_USE_TLS=""
# Base URL used in reset links
FRONTEND_URL=""