# JWT signing secret — use a long random value
# Generate secret key with this command in terminal: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=""

# --- PostgreSQL (Docker Compose) ------------------------------------
# Single source of truth: docker-compose.yml uses these for the container,
POSTGRES_USER=blog_user
POSTGRES_PASSWORD=password
POSTGRES_DB=blog_db
POSTGRES_PORT=5432
# Optional: name for the test database created by docker/initdb/01-create-test-db.sh
# (defaults to test_blog_db). Only used by Docker Compose, not the Python app.
TEST_POSTGRES_DB=test_blog_db

S3_BUCKET_NAME=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

MAIL_SERVER=""
MAIL_PORT=""
MAIL_USERNAME=""
MAIL_PASSWORD=""
MAIL_FROM=""
MAIL_USE_TLS=""
# Base URL used in reset links
FRONTEND_URL=""